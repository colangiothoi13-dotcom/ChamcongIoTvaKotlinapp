    }
    function validWorkEmployeeUpdate(id, old, data) {
      let keys = data.diff(old).affectedKeys();
      return isOwnEmployee(old.assigneeId) && activeWorkEmployee(old.assigneeId)
        && keys.hasOnly(['status', 'resultReport', 'resultAttachments', 'version', 'updatedAt', 'lastUpdatedById', 'lastUpdatedByName'])
        // Immutable references already stored on this task remain certified. Validate the
        // complete list whenever the employee changes/adds the attachment field.
        && (!keys.hasAny(['resultAttachments']) || validWorkAttachments(id, data))
        && (old.status == 'ASSIGNED'
          ? (data.status == 'IN_PROGRESS' && data.resultReport == old.resultReport
            && workAttachments(data) == workAttachments(old)
            && matchingWorkHistory(id, old, data, 'STARTED'))
          : (old.status == 'IN_PROGRESS' && (data.status == 'IN_PROGRESS'
            ? matchingWorkHistory(id, old, data, 'PROGRESS_UPDATED')
            // validWorkItem already requires text or attachments for PENDING_REVIEW.
            : (data.status == 'PENDING_REVIEW'
              && matchingWorkHistory(id, old, data, 'RESULT_SUBMITTED')))));
    }
    function validWorkReview(id, old, data) {
      return isAdmin() && old.status == 'PENDING_REVIEW'
        && data.diff(old).affectedKeys().hasOnly(['status', 'managerFeedback', 'completedAt', 'reworkCount',
          'resultAttachments', 'version', 'updatedAt', 'lastUpdatedById', 'lastUpdatedByName'])
        && workAttachments(data) == workAttachments(old)
        && ((data.status == 'COMPLETED' && data.completedAt == request.time
            && data.reworkCount == old.reworkCount && matchingWorkHistory(id, old, data, 'APPROVED'))
          || (data.status == 'IN_PROGRESS' && data.completedAt == null && nonBlank(data.managerFeedback)
            && data.reworkCount == old.reworkCount + 1 && matchingWorkHistory(id, old, data, 'REWORK_REQUESTED')));
    }
    match /workItems/{id} {
      allow read: if isAdmin() || (isOwnEmployee(resource.data.assigneeId) && activeWorkEmployee(resource.data.assigneeId));
      allow create: if validWorkCreate(id, request.resource.data);
      allow update: if validWorkItem(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.assignedById == resource.data.assignedById
        && request.resource.data.assignedByName == resource.data.assignedByName
        && (validWorkEdit(id, resource.data, request.resource.data)
          || validWorkEmployeeUpdate(id, resource.data, request.resource.data)
          || validWorkReview(id, resource.data, request.resource.data));
      allow delete: if false;
      match /history/{version} {
        allow read: if isAdmin() || (isOwnEmployee(get(workItemPath(id)).data.assigneeId)
          && activeWorkEmployee(get(workItemPath(id)).data.assigneeId));
        allow create: if existsAfter(workItemPath(id))
          && version == string(getAfter(workItemPath(id)).data.version)
          && matchingWorkHistory(id, exists(workItemPath(id)) ? get(workItemPath(id)).data : null,
            getAfter(workItemPath(id)).data, request.resource.data.action)
          && getAfter(workItemPath(id)).data.updatedAt == request.time
          && (!exists(workItemPath(id)) || getAfter(workItemPath(id)).data.version == get(workItemPath(id)).data.version + 1);
      allow update, delete: if false;
      }
      match /attachments/{attachmentId} {
        allow read: if canReadWorkAttachment(id, resource == null ? null : resource.data);
        allow create: if validWorkAttachmentCreate(id, attachmentId, request.resource.data);
        allow update, delete: if false;
        match /chunks/{index} {
          allow read: if canReadWorkAttachment(id, get(workAttachmentPath(id, attachmentId)).data);
          allow create: if validWorkAttachmentChunkCreate(id, attachmentId, index, request.resource.data);
          allow update, delete: if false;
        }
      }
    }

    match /employeeResources/{id} {
      allow read: if isAdmin() || employeeCanReadResource(resource.data);
      allow create: if isAdmin() && validEmployeeResource(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() && validEmployeeResource(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /employees/{id} {
      allow read: if isAdmin() || isOwnEmployee(id);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwnEmployee(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'address'])
