// Copy this file to secrets.h in this folder, then enter the local device Wi-Fi.
// secrets.h is ignored by Git and must not be committed.
#ifndef CHAMCONG_SECRETS_H
#define CHAMCONG_SECRETS_H

#define DEVICE_WIFI_SSID "YOUR_WIFI_SSID"
#define DEVICE_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
#define FIREBASE_WEB_API_KEY "YOUR_FIREBASE_WEB_API_KEY"
#define FIRESTORE_BASE_URL "https://firestore.googleapis.com/v1/projects/chamcongiot-56ae5/databases/(default)/documents"

// Keep 0 while using the existing fingerprint-only firmware. Set 1 only after
// configuring/running the laptop service and enabling the integrated station.
// Gateway mode NEVER falls back to writing attendance directly to Firestore.
// Device commands and heartbeat still use the Firebase configuration above.
#define ATTENDANCE_GATEWAY_MODE 0
#define ATTENDANCE_GATEWAY_URL "http://192.168.1.100:8765/v1/fingerprint"
#define ATTENDANCE_DEVICE_TOKEN "REPLACE_WITH_RANDOM_DEVICE_TOKEN"
#define ATTENDANCE_STATION_ID "GATE-01"

#endif // CHAMCONG_SECRETS_H
